{
  "name": "daycry/emailing",
  "description": "Plataforma de campañas y envío de email con SMTP configurable.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*",
    "ext-sodium": "*",
    "phpmailer/phpmailer": "^7.0"
  },
  "autoload": { "psr-4": { "Emailing\\": "src/" } },
  "scripts": {
    "test": "php tests/run.php",
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "worker": "php bin/console.php queue:work"
  },
  "config": { "sort-packages": true, "allow-plugins": false }
}
