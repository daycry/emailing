+$progress = static function (string $stage, array $facts = []): void {
+    if ($path = getenv('T12_PROGRESS')) {
+        file_put_contents($path, json_encode(['stage' => $stage, 'utc' => gmdate('c')] + $facts, JSON_THROW_ON_ERROR)."\n", FILE_APPEND);
