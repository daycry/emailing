+        $this->assertNull(app(OutboxDispatcher::class)->claim());
+        $this->trace('concurrent-global-claims', ['locked_event_id' => $ids[0], 'completed_while_lock_held' => $claims, 'after_release_event_id' => $next->id, 'distinct' => true]);
