+                DB::table('contacts')->insert($chunk);
+            }
+            $contacts = DB::table('contacts')->where('account_id', $this->account->id)->where('consent_source', $marker)->pluck('id')->all();
+            foreach (array_chunk($contacts, 500) as $chunk) {
