@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\Campaign;
+use App\Models\CampaignRecipient;
+use App\Models\CampaignRevision;
+use App\Models\Delivery;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+class DeliveryMaterializer
+{
+    private const BATCH_SIZE = 500;
+
+    public function materialize(int $accountId, int $campaignId): int
+    {
+        return DB::transaction(function () use ($accountId, $campaignId) {
+            Account::whereKey($accountId)->lockForUpdate()->firstOrFail();
+            $campaign = Campaign::where('account_id', $accountId)->whereKey($campaignId)->lockForUpdate()->firstOrFail();
+            $due = Campaign::whereKey($campaign->id)->whereIn('status', ['authorized', 'scheduled'])->whereNotNull('authorized_at')->whereNotNull('reviewed_revision_id')->where('effective_at', '<=', DB::raw('UTC_TIMESTAMP(6)'))->exists();
+            if (! $due) {
+                return 0;
+            }
+            $revision = CampaignRevision::where('account_id', $accountId)->where('campaign_id', $campaignId)->findOrFail($campaign->reviewed_revision_id);
+            $existing = Delivery::where('account_id', $accountId)->where('campaign_revision_id', $revision->id)->pluck('campaign_recipient_id')->flip();
+            $dbNow = DB::selectOne('SELECT UTC_TIMESTAMP(6) AS db_now')->db_now;
+            $created = 0;
+            $deliveries = [];
+            $events = [];
+            foreach (CampaignRecipient::where('account_id', $accountId)->where('campaign_revision_id', $revision->id)->orderBy('id')->cursor() as $recipient) {
+                if ($existing->has($recipient->id)) {
+                    continue;
+                }
+                $deliveryId = (string) Str::uuid();
+                $deliveries[] = ['id' => $deliveryId, 'account_id' => $accountId, 'campaign_id' => $campaignId, 'campaign_revision_id' => $revision->id, 'campaign_recipient_id' => $recipient->id, 'source_hash' => $revision->source_hash, 'status' => 'pending', 'generation' => 1, 'created_at' => $dbNow, 'updated_at' => $dbNow];
+                $events[] = ['id' => (string) Str::uuid(), 'account_id' => $accountId, 'delivery_id' => $deliveryId, 'generation' => 1, 'type' => 'delivery.ready', 'status' => 'pending', 'available_at' => $dbNow, 'created_at' => $dbNow, 'updated_at' => $dbNow];
+                $created++;
+                if (count($deliveries) === self::BATCH_SIZE) {
+                    $this->insertBatch($deliveries, $events);
+                    $deliveries = [];
+                    $events = [];
+                }
+            }
+            if ($deliveries !== []) {
+                $this->insertBatch($deliveries, $events);
+            }
+
+            return $created;
+        }, 3);
+    }
+
+    private function insertBatch(array $deliveries, array $events): void
+    {
+        DB::table('deliveries')->insert($deliveries);
+        DB::table('delivery_outbox')->insert($events);
+    }
+}
diff --git a/app/Services/OutboxDispatcher.php b/app/Services/OutboxDispatcher.php
--- /dev/null
+++ b/app/Services/OutboxDispatcher.php
@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\DeliveryOutbox;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+class OutboxDispatcher
+{
+    public function __construct(private ConfirmedDeliveryPublisher $publisher) {}
+
+    public function claim(?string $eventId = null): ?DeliveryOutbox
+    {
+        if (DBTransactionGuard::active()) {
+            throw new \LogicException('Dispatch requires an independent SQL transaction.');
+        }
+
+        return DB::transaction(function () use ($eventId) {
+            // The generated date orders by actual eligibility, including lease
+            // recovery, and excludes completed history from the index range.
+            $event = DeliveryOutbox::when($eventId, fn ($q) => $q->whereKey($eventId))->where('eligible_at', '<=', DB::raw('UTC_TIMESTAMP(6)'))->orderBy('eligible_at')->orderBy('id')->lock('FOR UPDATE SKIP LOCKED')->first();
+            if (! $event) {
+                return null;
+            }
+            $seconds = max(15, min(300, (int) config('delivery.lease_seconds')));
+            DeliveryOutbox::whereKey($event->id)->update(['status' => 'publishing', 'lease_token' => (string) Str::uuid(), 'lease_expires_at' => DB::raw('DATE_ADD(UTC_TIMESTAMP(6), INTERVAL '.$seconds.' SECOND)'), 'publish_attempts' => $event->publish_attempts + 1]);
+
+            return $event->fresh();
+        }, 3);
+    }
+
+    public function complete(DeliveryOutbox $claim, PublicationResult $result): bool
+    {
+        $retry = max(1, min(3600, (int) config('delivery.retry_seconds')));
+        $changes = ['status' => $result->confirmed ? 'published' : 'pending', 'lease_token' => null, 'lease_expires_at' => null, 'last_error' => $result->error, 'updated_at' => DB::raw('UTC_TIMESTAMP(6)')];
+        if ($result->confirmed) {
+            $changes['published_at'] = DB::raw('UTC_TIMESTAMP(6)');
+        } else {
+            $changes['available_at'] = DB::raw('DATE_ADD(UTC_TIMESTAMP(6), INTERVAL '.$retry.' SECOND)');
+        }
+
+        return DeliveryOutbox::whereKey($claim->id)->where('account_id', $claim->account_id)->where('delivery_id', $claim->delivery_id)->where('generation', $claim->generation)->where('status', 'publishing')->where('lease_token', $claim->lease_token)->where('lease_expires_at', '>', DB::raw('UTC_TIMESTAMP(6)'))->update($changes) === 1;
+    }
+
+    public function dispatch(?string $eventId = null): bool
+    {
+        $claim = $this->claim($eventId);
+        if (! $claim) {
+            return false;
+        }
+        $result = $this->publisher->publish($claim);
+        $this->complete($claim, $result);
+
+        return true;
+    }
+}
