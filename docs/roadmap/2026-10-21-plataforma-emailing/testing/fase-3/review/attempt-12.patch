++            $connection = new AMQPStreamConnection($host['host'], $host['port'], $host['user'], $host['password'], $host['vhost'], false, 'AMQPLAIN', null, 'en_US', $timeout, $timeout + 1, null, false, 0, $timeout);
++            $channel = $connection->channel();
