+        $audience = (new DOMXPath($document))->query('//*[@data-testid="campaign-reviewed-audience"]')->item(0);
+        $this->assertNotNull($audience);
+        $this->assertStringNotContainsString('Destinatario 11', $audience->textContent);
+        $component->call('setPage', 2, 'recipientsPage')->assertSee('Destinatario 11');
+        $this->assertArrayNotHasKey('recipients', $component->snapshot['data']);
+        $this->assertArrayNotHasKey('revision', $component->snapshot['data']);
+        $this->assertArrayNotHasKey('html', $component->snapshot['data']);
+    }
+
+    public function test_stale_component_rejects_another_teammates_version_and_shows_reopen_action(): void
+    {
+        $campaign = $this->reviewed();
+        $component = Livewire::test(Campaigns::class)->call('open', $campaign->id);
+        $this->service->save($this->account, $this->owner->id, $campaign->id, $campaign->version, $this->input(['name' => 'Otra versión']));
+        $component->call('$refresh')->assertSee('Otra persona cambió esta campaña')->assertSee('Volver a abrir la versión actual')->call('review')->assertStatus(409);
+        $this->assertSame('Otra versión', $campaign->fresh()->name);
+        $this->assertSame('draft', $campaign->fresh()->status);
+    }
+}
diff --git a/tests/Feature/ConcurrentCampaignTest.php b/tests/Feature/ConcurrentCampaignTest.php
--- /dev/null
+++ b/tests/Feature/ConcurrentCampaignTest.php
@@ -0,0 +1,153 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Account;
+use App\Models\AuditEvent;
+use Illuminate\Foundation\Testing\DatabaseMigrations;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Symfony\Component\Process\Process;
+use Tests\Concerns\InteractsWithCampaigns;
+use Tests\TestCase;
+
+class ConcurrentCampaignTest extends TestCase
+{
+    use DatabaseMigrations;
+    use InteractsWithCampaigns;
+
+    private function parallel(array $actions): array
+    {
+        $directory = storage_path('app/private/campaign-concurrency-'.Str::uuid());
+        mkdir($directory, 0700, true);
+        $processes = [];
+        try {
+            foreach ($actions as $i => $action) {
+                $process = new Process([PHP_BINARY, base_path('tests/support/campaign-action.php')], base_path(), ['APP_ENV' => 'testing', 'DB_DATABASE' => 'emailing_testing', 'DB_USERNAME' => 'emailing_testing', 'DB_URL' => '']);
+                $process->setInput(json_encode($action + ['account_id' => $this->account->id, 'actor_id' => $this->owner->id, 'ready' => $directory.'/ready-'.$i, 'start' => $directory.'/start'], JSON_THROW_ON_ERROR));
+                $process->setTimeout(30);
+                $process->start();
+                $processes[] = $process;
+            }
+            $deadline = microtime(true) + 15;
+            do {
+                $ready = count(glob($directory.'/ready-*')) === count($processes);
+                if (microtime(true) > $deadline) {
+                    $this->fail('Los procesos concurrentes no llegaron a la barrera: '.implode(' ', array_map(fn ($p) => $p->getErrorOutput(), $processes)));
+                }
+                usleep(10000);
+            } while (! $ready);
+            file_put_contents($directory.'/start', 'start');
+            foreach ($processes as $process) {
+                $process->wait();
+                $this->assertTrue($process->isSuccessful(), $process->getErrorOutput());
+            }
+
+            return array_map(fn ($p) => trim($p->getOutput()), $processes);
+        } finally {
+            foreach ($processes as $process) {
+                if ($process->isRunning()) {
+                    $process->stop();
+                }
+            }
+            foreach (glob($directory.'/*') as $file) {
+                unlink($file);
+            }
+            rmdir($directory);
+        }
+    }
+
+    public function test_two_mysql_processes_authorize_exactly_one_reviewed_version(): void
+    {
+        $campaign = $this->reviewed();
+        $action = ['action' => 'authorize', 'id' => $campaign->id, 'version' => $campaign->version, 'revision_id' => $campaign->reviewed_revision_id];
+        $results = $this->parallel([$action, $action]);
+        sort($results);
+        $this->assertSame(['authorized', 'rejected:409'], $results);
+        $this->assertSame($campaign->version + 1, $campaign->fresh()->version);
+        $this->assertSame(1, AuditEvent::where('action', 'campaign.authorized')->count());
+        $this->assertDatabaseCount('campaign_recipients', 1);
+    }
+
+    public function test_two_mysql_processes_edit_and_authorize_cannot_commit_an_unseen_composition(): void
+    {
+        $campaign = $this->reviewed();
+        $base = ['id' => $campaign->id, 'version' => $campaign->version, 'revision_id' => $campaign->reviewed_revision_id];
+        $results = $this->parallel([['action' => 'authorize'] + $base, ['action' => 'save', 'input' => $this->input(['name' => 'Concurrente'])] + $base]);
+        $this->assertSame(1, count(array_filter($results, fn ($value) => $value === 'rejected:409')));
+        $this->assertSame($campaign->version + 1, $campaign->fresh()->version);
+        if ($campaign->fresh()->status === 'authorized') {
+            $this->assertSame('Noticias', $campaign->fresh()->name);
+            $this->assertSame(1, AuditEvent::where('action', 'campaign.authorized')->count());
+        } else {
+            $this->assertSame('draft', $campaign->fresh()->status);
+            $this->assertSame('Concurrente', $campaign->fresh()->name);
+            $this->assertNull($campaign->fresh()->reviewed_revision_id);
+            $this->assertSame(0, AuditEvent::where('action', 'campaign.authorized')->count());
+        }
+    }
+
+    public function test_two_mysql_processes_pause_only_once_and_old_resume_version_is_rejected(): void
+    {
+        $campaign = $this->authorize($this->reviewed());
+        $action = ['action' => 'pause', 'id' => $campaign->id, 'version' => $campaign->version];
+        $results = $this->parallel([$action, $action]);
+        sort($results);
+        $this->assertSame(['paused', 'rejected:409'], $results);
+        $this->assertRejected(409, fn () => $this->service->resume($this->account, $this->owner->id, $campaign->id, $campaign->version));
+        $this->assertSame('paused', $campaign->fresh()->status);
+        $this->assertSame(0, $this->service->due($this->account)->count());
+    }
+
+    public function test_authorization_waiting_on_mysql_account_mutex_observes_committed_scope_revocation(): void
+    {
+        $campaign = $this->reviewed();
+        $member = $this->member(['campaigns.read', 'campaigns.write', 'contacts.read', 'templates.read', 'mail.send']);
+        $directory = storage_path('app/private/campaign-revocation-'.Str::uuid());
+        mkdir($directory, 0700, true);
+        $process = new Process([PHP_BINARY, base_path('tests/support/campaign-action.php')], base_path(), ['APP_ENV' => 'testing', 'DB_DATABASE' => 'emailing_testing', 'DB_USERNAME' => 'emailing_testing', 'DB_URL' => '']);
+        $process->setInput(json_encode(['action' => 'authorize', 'account_id' => $this->account->id, 'actor_id' => $member->user_id, 'id' => $campaign->id, 'version' => $campaign->version, 'revision_id' => $campaign->reviewed_revision_id, 'ready' => $directory.'/ready', 'start' => $directory.'/start', 'attempting' => $directory.'/attempting'], JSON_THROW_ON_ERROR));
+        $process->setTimeout(30);
+        DB::beginTransaction();
+        try {
+            Account::whereKey($this->account->id)->lockForUpdate()->firstOrFail();
+            $process->start();
+            $deadline = microtime(true) + 15;
+            while (! is_file($directory.'/ready')) {
+                if (microtime(true) > $deadline) {
+                    $this->fail('El proceso no llegó a la barrera: '.$process->getErrorOutput());
+                }
+                usleep(10000);
+            }
+            file_put_contents($directory.'/start', 'start');
+            while (! is_file($directory.'/attempting')) {
+                if (microtime(true) > $deadline) {
+                    $this->fail('El proceso no intentó la autorización.');
+                }
+                usleep(10000);
+            }
+            $member->update(['scopes' => ['campaigns.read', 'campaigns.write', 'contacts.read', 'templates.read']]);
+            // The child has attempted the service while this real MySQL lock remains held.
+            usleep(150000);
+            $this->assertTrue($process->isRunning());
+            DB::commit();
+            $process->wait();
+            $this->assertTrue($process->isSuccessful(), $process->getErrorOutput());
+            $this->assertSame('rejected:403', trim($process->getOutput()));
+            $this->assertSame('reviewed', $campaign->fresh()->status);
+            $this->assertNull($campaign->fresh()->authorized_at);
+            $this->assertSame(0, AuditEvent::where('action', 'campaign.authorized')->count());
+        } finally {
+            if (DB::transactionLevel() > 0) {
+                DB::rollBack();
+            }
+            if ($process->isRunning()) {
+                $process->stop();
+            }
+            foreach (glob($directory.'/*') as $file) {
+                unlink($file);
+            }
+            rmdir($directory);
+        }
+    }
+}
diff --git a/tests/Unit/CompiledTemplateTest.php b/tests/Unit/CompiledTemplateTest.php
--- /dev/null
+++ b/tests/Unit/CompiledTemplateTest.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace Tests\Unit;
+
+use App\Services\CampaignService;
+use App\Support\TemplateRenderer;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+class CompiledTemplateTest extends TestCase
+{
+    public function test_compiled_source_keeps_escaping_literal_substitution_and_distinct_recipient_values(): void
+    {
+        $renderer = new TemplateRenderer;
+        $compiled = $renderer->compile('<p>{{ contact.name }} {{ contact.email }} {{ account.name }}</p>', 'html', true);
+        $this->assertSame('<p>Ana &amp; Luis a@example.test Cuenta</p>', $compiled(['contact.name' => 'Ana & Luis', 'contact.email' => 'a@example.test', 'account.name' => 'Cuenta']));
+        $this->assertSame('<p>{{ account.name }}  </p>', $compiled(['contact.name' => '{{ account.name }}']));
+        $this->assertSame('<p>&quot;&lt;b&gt;  </p>', $compiled(['contact.name' => '"<b>']));
+        $this->assertSame('<p>  </p>', $compiled([]));
+    }
+
+    public function test_compile_rejects_unknown_malformed_and_non_text_html_tokens_before_returning_callable(): void
+    {
+        foreach (['<p>{{ secret }}</p>', '<p>{{ contact.name</p>', '<a href="{{ contact.email }}">x</a>', '<p style="color:{{ contact.name }}">x</p>', '<script>{{ contact.name }}</script>', '<!-- {{ contact.name }} -->', '<textarea>{{ contact.name }}</textarea>'] as $html) {
+            try {
+                (new TemplateRenderer)->compile($html, 'html', true);
+                $this->fail('No se debe crear un callable para fuentes inválidas.');
+            } catch (ValidationException $error) {
+                $this->assertArrayHasKey('html', $error->errors());
+            }
+        }
+    }
+
+    public function test_every_compiled_invocation_checks_value_type_encoding_length_and_expanded_subject(): void
+    {
+        $renderer = new TemplateRenderer;
+        $compiled = $renderer->compile('{{ contact.name }}', 'subject');
+        $this->assertSame('Válido', $compiled(['contact.name' => 'Válido']));
+        foreach ([[], 123, "\xFF", str_repeat('x', 513), "Ana\r\nBcc: x@example.test", str_repeat('x', 201), '', '   '] as $value) {
+            try {
+                $compiled(['contact.name' => $value]);
+                $this->fail('Se aceptó valor o cabecera inválidos en el callable reutilizado.');
+            } catch (ValidationException $error) {
+                $this->assertTrue(isset($error->errors()['values']) || isset($error->errors()['subject']));
+            }
+        }
+        $this->assertSame('Otra persona', $compiled(['contact.name' => 'Otra persona']));
+        $this->assertSame(str_repeat('á', 200), $compiled(['contact.name' => str_repeat('á', 200)]));
+    }
+
+    public function test_compiled_source_and_each_expansion_keep_byte_and_token_limits(): void
+    {
+        $renderer = new TemplateRenderer;
+        foreach ([str_repeat('x', 100001), str_repeat('{{ contact.name }}', 201), "\xFF"] as $source) {
+            try {
+                $renderer->compile($source, 'text');
+                $this->fail('Se aceptó una fuente fuera de límites.');
+            } catch (ValidationException $error) {
+                $this->assertArrayHasKey('text', $error->errors());
+            }
+        }
+        $compiled = $renderer->compile(str_repeat('x', 99000).str_repeat('{{ contact.name }}', 50), 'text');
+        $this->assertSame(99050, strlen($compiled(['contact.name' => 'a'])));
+        $this->assertSame(124600, strlen($compiled(['contact.name' => str_repeat('x', 512)])));
+        $html = $renderer->compile(str_repeat('x', 99000).str_repeat('{{ contact.name }}', 50), 'html', true);
+        try {
+            $html(['contact.name' => str_repeat('&', 512)]);
+            $this->fail('Se aceptó una expansión HTML de más de 200.000 bytes.');
+        } catch (ValidationException $error) {
+            $this->assertArrayHasKey('html', $error->errors());
+        }
+    }
+
+    public function test_campaign_batch_compiles_each_field_once_and_checks_each_recipient(): void
+    {
+        $renderer = new class extends TemplateRenderer
+        {
+            public array $fields = [];
+
+            public function compile(string $source, string $field, bool $html = false): \Closure
+            {
+                $this->fields[] = $field;
+
+                return parent::compile($source, $field, $html);
+            }
+        };
+        $service = new CampaignService($renderer);
+        $content = ['subject' => '{{ contact.name }}', 'html' => '<p>{{ contact.name }}</p>', 'text' => '{{ contact.email }}'];
+        $recipients = [['name' => 'Ana', 'email' => 'a@example.test'], ['name' => 'Luis', 'email' => 'b@example.test']];
+        $service->validateBatch($content, 'Cuenta', $recipients);
+        $this->assertSame(['subject', 'html', 'text'], $renderer->fields);
+        $recipients[] = ['name' => "Cabecera\r\nmaliciosa", 'email' => 'c@example.test'];
+        try {
+            $service->validateBatch($content, 'Cuenta', $recipients);
+            $this->fail('La validación del lote omitió el último destinatario.');
+        } catch (ValidationException $error) {
+            $this->assertArrayHasKey('subject', $error->errors());
+        }
+    }
+}
