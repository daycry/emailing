+    public function test_legacy_test_send_and_worker_share_atomic_account_and_pool_quota(): void
+    {
+        $event = $this->event();
+        $this->relay();
+        $policy = ['delivery.quotas.account.minute' => 10, 'delivery.quotas.account.day' => 1];
