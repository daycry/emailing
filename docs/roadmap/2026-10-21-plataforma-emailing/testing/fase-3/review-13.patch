diff --git a/app/Services/DeliveryQuota.php b/app/Services/DeliveryQuota.php
--- /dev/null
+++ b/app/Services/DeliveryQuota.php
@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Services;
+
+use Illuminate\Support\Facades\DB;
+
+class DeliveryQuota
+{
+    // Caller holds the account mutex. All quota locks follow it, sorted by key.
+    // Fixed UTC minute/day windows allow a burst up to the configured minute cap;
+    // adjoining windows can admit two such bursts. Ambiguous starts remain charged.
+    public function take(int $accountId): ?string
+    {
+        $pool = (string) config('delivery.relay_pool');
+        if (! preg_match('/\A[a-zA-Z0-9_.-]{1,80}\z/D', $pool)) {
+            throw new \LogicException('A server-owned relay pool identity is required.');
+        }
+        $now = (int) DB::selectOne('SELECT UNIX_TIMESTAMP() AS epoch')->epoch;
+        $windows = [];
+        foreach (['pool:'.$pool => 'pool', 'account:'.$accountId => 'account'] as $scope => $policy) {
+            foreach (['minute' => 60, 'day' => 86400] as $window => $seconds) {
+                $start = intdiv($now, $seconds) * $seconds;
+                $id = $scope.':'.$window.':'.$start;
+                $windows[$id] = ['limit' => max(1, min(1000000000, (int) config('delivery.quotas.'.$policy.'.'.$window))), 'ends_at' => gmdate('Y-m-d H:i:s', $start + $seconds)];
+            }
+        }
+        ksort($windows, SORT_STRING);
+        $waitUntil = null;
+        foreach ($windows as $id => $window) {
+            DB::table('delivery_quota_windows')->insertOrIgnore(['id' => $id, 'used' => 0, 'ends_at' => $window['ends_at']]);
+            $row = DB::table('delivery_quota_windows')->where('id', $id)->lockForUpdate()->first();
+            if ($row->used >= $window['limit']) {
+                $waitUntil = max($waitUntil ?? $row->ends_at, $row->ends_at);
+            }
+        }
+        $lockedEpoch = (int) DB::selectOne('SELECT UNIX_TIMESTAMP() AS epoch')->epoch;
+        if (intdiv($lockedEpoch, 60) !== intdiv($now, 60)) {
+            // Waiting for another account's pool mutex can cross a UTC window.
+            // Do not charge stale buckets or acquire another set while holding these.
+            return gmdate('Y-m-d H:i:s', $lockedEpoch + 1);
+        }
+        if ($waitUntil !== null) {
+            return $waitUntil;
+        }
+        foreach (array_keys($windows) as $id) {
+            DB::table('delivery_quota_windows')->where('id', $id)->increment('used');
+        }
+
+        return null;
+    }
+}
diff --git a/app/Services/ObservedSmtpTransport.php b/app/Services/ObservedSmtpTransport.php
--- /dev/null
+++ b/app/Services/ObservedSmtpTransport.php
@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Services;
+
+use Symfony\Component\Mailer\Exception\UnexpectedResponseException;
+use Symfony\Component\Mailer\SentMessage;
+use Symfony\Component\Mailer\Transport\Smtp\EsmtpTransport;
+
+class ObservedSmtpTransport extends EsmtpTransport
+{
+    public bool $accepted = false;
+
+    public bool $possibleAcceptance = false;
+
+    public bool $messageEntered = false;
+
+    public ?array $firstFailure = null;
+
+    public ?\Closure $heartbeat = null;
+
+    public ?\Closure $protocol = null;
+
+    protected function doSend(SentMessage $message): void
+    {
+        $this->messageEntered = true;
+        parent::doSend($message);
+    }
+
+    public function executeCommand(string $command, array $codes): string
+    {
+        $stage = match (true) {
+            $command === "\r\n.\r\n" => 'data_final',
+            $command === "DATA\r\n" => 'data',
+            str_starts_with($command, 'MAIL FROM:') => 'mail',
+            str_starts_with($command, 'RCPT TO:') => 'recipient',
+            str_starts_with($command, 'RSET') || str_starts_with($command, 'QUIT') => 'cleanup',
+            default => 'session',
+        };
+        if ($stage !== 'cleanup' && $this->heartbeat) {
+            ($this->heartbeat)();
+        }
+        if ($stage === 'data_final') {
+            // Set BEFORE the write, including failure while writing the terminator.
+            $this->possibleAcceptance = true;
+        }
+        $started = hrtime(true);
+        $failed = false;
+        $code = null;
+        try {
+            $reply = parent::executeCommand($command, $codes);
+            if ($stage === 'data_final') {
+                $this->accepted = true;
+            }
+
+            return $reply;
+        } catch (\Throwable $error) {
+            $failed = true;
+            $code = $error instanceof UnexpectedResponseException ? $error->getCode() : 0;
+            // EHLO/AUTH negotiation may recover internally (e.g. HELO fallback).
+            // Only a failed message command can establish a latched negative outcome.
+            if (in_array($stage, ['mail', 'recipient', 'data', 'data_final'], true) && $this->firstFailure === null) {
+                $code = $error instanceof UnexpectedResponseException ? $error->getCode() : 0;
+                $this->firstFailure = ['stage' => $stage, 'code' => $code, 'negative' => $code >= 400 && $code <= 599];
+            }
+            throw $error;
+        } finally {
+            if ($this->protocol) {
+                ($this->protocol)('command', ['phase' => $stage, 'elapsed_seconds' => (hrtime(true) - $started) / 1e9, 'failed' => $failed, 'reply_code' => $code]);
+            }
+        }
+    }
+}
