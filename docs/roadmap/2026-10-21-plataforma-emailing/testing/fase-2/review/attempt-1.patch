diff --git a/app/Services/AccountMailTransport.php b/app/Services/AccountMailTransport.php
new file mode 100644
index 0000000..6c4b88e
--- /dev/null
+++ b/app/Services/AccountMailTransport.php
@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\MailMessage;
+use App\Models\MailSender;
+use App\Models\MailSetting;
+use App\Support\MailInput;
+use App\Support\SmtpUnconfirmed;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Symfony\Component\Mime\Address;
+use Symfony\Component\Mime\Email;
+
+class AccountMailTransport
+{
+    public function __construct(private SmtpConnector $smtp) {}
+
+    // No HTTP/session dependency: workers and template facades supply an already validated account.
+    public function send(Account $account, int $senderId, array $input, ?int $actorId = null): MailMessage
+    {
+        $data = MailInput::message($input);
+        $sender = MailSender::where('account_id', $account->id)->findOrFail($senderId);
+        abort_unless($sender->lab_authorized, 403, 'El remitente no está autorizado para el laboratorio.');
+        $mode = MailSetting::where('account_id', $account->id)->value('mode') ?? 'log';
+        $email = (new Email)->from(new Address($sender->email, $sender->name))->to($data['recipient'])->subject($data['subject'])->text($data['text']);
+        if ($sender->reply_to) {
+            $email->replyTo($sender->reply_to);
+        }
+        if (! empty($data['html'])) {
+            $email->html($data['html']);
+        }
+        $record = MailMessage::create(['account_id' => $account->id, 'mail_sender_id' => $sender->id, 'actor_id' => $actorId, 'mode' => $mode, 'status' => 'preparing', 'sender_email' => $sender->email, 'recipient' => $data['recipient'], 'subject' => $data['subject']]);
+        if ($mode === 'log') {
+            $path = $account->id.'/'.Str::uuid().'.eml';
+            try {
+                Storage::disk('mail-artifacts')->put($path, $email->toString());
+                $record->update(['status' => 'logged', 'artifact_path' => $path]);
+            } catch (\Throwable) {
+                $record->update(['status' => 'local_failed', 'diagnostic' => 'artifact_failed']);
+            }
+        } elseif ($mode === 'mailpit') {
+            try {
+                $this->smtp->send(['host' => (string) config('emailing.mailpit.host'), 'port' => (int) config('emailing.mailpit.port'), 'security' => 'plain'], $email);
+                $record->update(['status' => 'smtp_accepted']);
+            } catch (SmtpUnconfirmed) {
+                $record->update(['status' => 'smtp_unconfirmed', 'diagnostic' => 'smtp_unconfirmed']);
+            }
+        } else {
+            $record->update(['status' => 'blocked', 'diagnostic' => 'external_not_enabled']);
+        }
+
+        return $record;
+    }
+}
diff --git a/app/Services/ContactImportService.php b/app/Services/ContactImportService.php
new file mode 100644
index 0000000..25bc2ea
--- /dev/null
+++ b/app/Services/ContactImportService.php
@@ -0,0 +1,201 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\AuditEvent;
+use App\Models\Contact;
+use App\Models\ContactImport;
+use App\Models\ContactImportRow;
+use App\Models\ContactList;
+use App\Models\Membership;
+use App\Support\ContactCsv;
+use DateTimeImmutable;
+use DateTimeZone;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Features\SupportFileUploads\TemporaryUploadedFile;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+use Throwable;
+
+class ContactImportService
+{
+    public function __construct(private AccountContext $context, private ContactCsv $csv) {}
+
+    public function imports(): Builder
+    {
+        return ContactImport::where('account_id', $this->context->authorize('contacts.read')->account_id)->orderByDesc('id');
+    }
+
+    public function report(int $id): ContactImport
+    {
+        return $this->imports()->findOrFail($id);
+    }
+
+    public function rows(int $id): Builder
+    {
+        $report = $this->report($id);
+
+        return ContactImportRow::where('account_id', $report->account_id)->where('contact_import_id', $report->id)->orderBy('row_number');
+    }
+
+    public function import(UploadedFile $file, ?int $listId = null): ContactImport
+    {
+        $member = $this->context->authorize('contacts.write');
+        $this->context->authorize('contacts.read');
+        if ($file instanceof TemporaryUploadedFile) {
+            $binding = session('contact_import_uploads.'.hash('sha256', $file->getFilename()));
+            abort_unless(is_array($binding) && $binding['account_id'] === $member->account_id && $binding['user_id'] === auth()->id() && $binding['at'] >= time() - 3600, 403);
+            if (! $file->exists()) {
+                throw ValidationException::withMessages(['file' => 'La subida temporal ya no está disponible. Vuelve a seleccionar el archivo.']);
+            }
+        }
+        if ($listId !== null) {
+            ContactList::where('account_id', $member->account_id)->findOrFail($listId);
+        }
+        $maxBytes = (int) config('emailing.import_max_bytes');
+        Validator::make(['file' => $file], ['file' => ['bail', 'required', 'file', 'max:'.(int) ceil($maxBytes / 1024), 'extensions:csv']])->validate();
+        $contents = file_get_contents($file->getRealPath(), false, null, 0, $maxBytes + 1);
+        if ($contents === false || strlen($contents) > $maxBytes) {
+            throw ValidationException::withMessages(['file' => 'El archivo supera el límite de '.$maxBytes.' bytes o no se puede leer.']);
+        }
+        $rawRows = $this->csv->parse($contents, (int) config('emailing.import_max_rows'));
+        [$rows, $candidates] = $this->validateRows($rawRows);
+        $path = 'sources/'.Str::uuid().'.csv';
+        Storage::disk('contact-imports')->put($path, $contents);
+        try {
+            return DB::transaction(function () use ($member, $listId, $rows, $candidates, $path) {
+                $current = $this->context->authorize('contacts.write');
+                $this->context->authorize('contacts.read');
+                abort_unless($current->account_id === $member->account_id, 403);
+                $account = Account::whereKey($current->account_id)->lockForUpdate()->firstOrFail();
+                $lockedMember = Membership::where('account_id', $account->id)->where('user_id', auth()->id())->lockForUpdate()->first();
+                abort_unless($lockedMember && Permissions::allows($lockedMember, 'contacts.write') && Permissions::allows($lockedMember, 'contacts.read'), 403);
+                if ($listId !== null) {
+                    ContactList::where('account_id', $account->id)->lockForUpdate()->findOrFail($listId);
+                }
+                $existing = [];
+                foreach (array_chunk(array_keys($candidates), 500) as $emails) {
+                    foreach (Contact::where('account_id', $account->id)->whereIn('email', $emails)->lockForUpdate()->get(['id', 'email']) as $contact) {
+                        $existing[$contact->email] = $contact->id;
+                    }
+                }
+                $new = [];
+                $timestamp = now()->format('Y-m-d H:i:s');
+                foreach ($candidates as $email => $candidate) {
+                    $index = $candidate['index'];
+                    if (isset($existing[$email])) {
+                        $rows[$index]['status'] = 'duplicate';
+                        $rows[$index]['message'] = 'Email activo existente en esta cuenta; no se modifica.';
+                    } else {
+                        $new[$email] = ['account_id' => $account->id, 'created_at' => $timestamp, 'updated_at' => $timestamp] + $candidate['data'];
+                        $rows[$index]['status'] = 'imported';
+                        $rows[$index]['message'] = 'Contacto creado.';
+                    }
+                }
+                foreach (array_chunk(array_values($new), 500) as $chunk) {
+                    Contact::insert($chunk);
+                }
+                if ($listId !== null) {
+                    foreach (array_chunk(array_keys($new), 500) as $emails) {
+                        $ids = Contact::where('account_id', $account->id)->whereIn('email', $emails)->lockForUpdate()->pluck('id');
+                        DB::table('contact_list_memberships')->insert($ids->map(fn ($id) => ['account_id' => $account->id, 'contact_list_id' => $listId, 'contact_id' => $id])->all());
+                    }
+                }
+                $counts = array_count_values(array_column($rows, 'status'));
+                $report = ContactImport::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'destination_list_id' => $listId, 'source_path' => $path, 'total' => count($rows), 'imported' => $counts['imported'] ?? 0, 'invalid' => $counts['invalid'] ?? 0, 'duplicates' => $counts['duplicate'] ?? 0]);
+                foreach (array_chunk($rows, 500) as $chunk) {
+                    ContactImportRow::insert(array_map(fn ($row) => ['account_id' => $account->id, 'contact_import_id' => $report->id] + $row, $chunk));
+                }
+                AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'contacts.imported', 'metadata' => ['import_id' => $report->id, 'source' => 'csv', 'total' => $report->total, 'imported' => $report->imported, 'invalid' => $report->invalid, 'duplicates' => $report->duplicates]]);
+
+                return $report;
+            });
+        } catch (Throwable $e) {
+            Storage::disk('contact-imports')->delete($path);
+            throw $e;
+        }
+    }
+
+    private function validateRows(array $rawRows): array
+    {
+        $rows = [];
+        $candidates = [];
+        $utc = new DateTimeZone('UTC');
+        $now = now('UTC')->toDateTimeImmutable();
+        foreach ($rawRows as $index => $raw) {
+            $data = array_fill_keys(ContactCsv::HEADERS, '');
+            $data = array_replace($data, $raw);
+            $data['email'] = mb_strtolower(trim($data['email']));
+            $data['consent_status'] = trim($data['consent_status']) ?: 'unknown';
+            $data['consent_source'] = trim($data['consent_source']) ?: null;
+            $data['consented_at'] = trim($data['consented_at']) ?: null;
+            // CSV parsing supplies strings. Bound lengths before native format validators;
+            // avoid constructing a full Laravel Validator for every one of 10,000 rows.
+            $errors = [];
+            if ($data['email'] === '' || mb_strlen($data['email']) > 254 || filter_var($data['email'], FILTER_VALIDATE_EMAIL, FILTER_FLAG_EMAIL_UNICODE) === false) {
+                $errors[] = 'Email inválido o superior a 254 caracteres.';
+            }
+            if (mb_strlen($data['name']) > 150) {
+                $errors[] = 'Nombre superior a 150 caracteres.';
+            }
+            if (! in_array($data['consent_status'], ['unknown', 'granted', 'revoked'], true)) {
+                $errors[] = 'Estado de consentimiento inválido.';
+            }
+            if ($data['consent_source'] !== null && mb_strlen($data['consent_source']) > 255) {
+                $errors[] = 'Fuente superior a 255 caracteres.';
+            }
+            $consentedAt = null;
+            if ($data['consented_at'] !== null) {
+                if (strlen($data['consented_at']) !== 16 || ! preg_match('/^[1-9]\d{3}-\d{2}-\d{2}T\d{2}:\d{2}$/D', $data['consented_at'])) {
+                    $errors[] = 'Fecha inválida: usa YYYY-MM-DDTHH:MM en UTC.';
+                } else {
+                    $consentedAt = DateTimeImmutable::createFromFormat('!Y-m-d\TH:i', $data['consented_at'], $utc);
+                    if (! $consentedAt || $consentedAt->format('Y-m-d\TH:i') !== $data['consented_at'] || $consentedAt > $now) {
+                        $errors[] = 'Fecha inexistente o futura.';
+                    }
+                }
+            }
+            if ($data['consent_status'] === 'granted' && ($data['consent_source'] === null || $data['consented_at'] === null)) {
+                $errors[] = 'Otorgado requiere fuente y fecha explícitas.';
+            }
+            $row = ['row_number' => $index + 2, 'email' => mb_substr($data['email'], 0, 254), 'status' => 'invalid', 'message' => ''];
+            if ($errors !== []) {
+                $row['message'] = implode(' ', $errors);
+            } elseif (isset($candidates[$data['email']])) {
+                $row['status'] = 'duplicate';
+                $row['message'] = 'Email repetido en el archivo; se conserva la primera fila válida.';
+            } else {
+                $data['consented_at'] = $data['consent_status'] === 'granted' ? $consentedAt->format('Y-m-d H:i:s') : null;
+                $data['consent_source'] = $data['consent_status'] === 'granted' ? $data['consent_source'] : null;
+                $candidates[$data['email']] = ['index' => $index, 'data' => $data];
+                $row['status'] = 'pending';
+            }
+            $rows[] = $row;
+        }
+
+        return [$rows, $candidates];
+    }
+
+    public function download(int $id): StreamedResponse
+    {
+        $this->report($id);
+
+        return response()->streamDownload(function () use ($id) {
+            $query = $this->rows($id);
+            $stream = fopen('php://output', 'w');
+            fputcsv($stream, ['registro', 'email', 'resultado', 'detalle'], ',', '"', '');
+            foreach ($query->cursor() as $row) {
+                $cells = [$row->row_number, $row->email, $row->status, $row->message];
+                $cells = array_map(fn ($value) => preg_match('/^[\s\x00-\x20]*[=+@-]/u', (string) $value) ? "'".$value : $value, $cells);
+                fputcsv($stream, $cells, ',', '"', '');
+            }
+            fclose($stream);
+        }, 'resultado-importacion-'.$id.'.csv', ['Content-Type' => 'text/csv; charset=UTF-8', 'Cache-Control' => 'private, no-store']);
+    }
+}
diff --git a/app/Services/ContactService.php b/app/Services/ContactService.php
new file mode 100644
index 0000000..c6f399d
--- /dev/null
+++ b/app/Services/ContactService.php
@@ -0,0 +1,168 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\AuditEvent;
+use App\Models\Contact;
+use App\Models\ContactList;
+use App\Models\Membership;
+use Carbon\Carbon;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class ContactService
+{
+    public function __construct(private AccountContext $context) {}
+
+    public function contacts(?int $listId = null, string $search = ''): Builder
+    {
+        $accountId = $this->context->authorize('contacts.read')->account_id;
+        $query = Contact::where('account_id', $accountId);
+        if ($listId !== null) {
+            ContactList::where('account_id', $accountId)->findOrFail($listId);
+            $query->whereHas('lists', fn ($lists) => $lists->where('contact_lists.id', $listId)->where('contact_lists.account_id', $accountId));
+        }
+        if ($search !== '') {
+            Validator::make(['search' => $search], ['search' => ['string', 'max:150']])->validate();
+            $query->where(fn ($q) => $q->where('email', 'like', '%'.$search.'%')->orWhere('name', 'like', '%'.$search.'%'));
+        }
+
+        return $query->orderBy('id', 'desc');
+    }
+
+    public function lists(): Builder
+    {
+        $accountId = $this->context->authorize('contacts.read')->account_id;
+
+        return ContactList::where('account_id', $accountId)->withCount('contacts')->orderBy('id', 'desc');
+    }
+
+    public function contact(int $id): Contact
+    {
+        return $this->contacts()->findOrFail($id);
+    }
+
+    public function list(int $id): ContactList
+    {
+        return $this->lists()->findOrFail($id);
+    }
+
+    private function writableAccount(): Account
+    {
+        $membership = $this->context->authorize('contacts.write');
+        // Serialize against TeamService role changes and account deletion.
+        $account = Account::whereKey($membership->account_id)->lockForUpdate()->firstOrFail();
+        $current = Membership::where('account_id', $account->id)->where('user_id', auth()->id())->lockForUpdate()->first();
+        abort_unless($current && Permissions::allows($current, 'contacts.write'), 403);
+
+        return $account;
+    }
+
+    private function audit(int $accountId, string $action, array $metadata): void
+    {
+        AuditEvent::create(['account_id' => $accountId, 'actor_id' => auth()->id(), 'action' => $action, 'metadata' => $metadata]);
+    }
+
+    public function saveContact(?int $id, array $input): Contact
+    {
+        return DB::transaction(function () use ($id, $input) {
+            $account = $this->writableAccount();
+            $contact = $id === null ? null : Contact::where('account_id', $account->id)->lockForUpdate()->findOrFail($id);
+            Validator::make($input, [
+                'email' => ['bail', 'required', 'string', 'max:254'],
+                'consent_source' => ['bail', 'nullable', 'string', 'max:255'],
+            ])->validate();
+            $input['email'] = mb_strtolower(trim($input['email']));
+            $input['consent_source'] = isset($input['consent_source']) ? (trim($input['consent_source']) ?: null) : null;
+            $data = Validator::make($input, [
+                'email' => ['bail', 'required', 'string', 'max:254', 'email:filter_unicode'],
+                'name' => ['present', 'string', 'max:150'],
+                'consent_status' => ['required', Rule::in(['unknown', 'granted', 'revoked'])],
+                'consent_source' => ['nullable', 'required_if:consent_status,granted', 'string', 'max:255'],
+                'consented_at' => ['nullable', 'required_if:consent_status,granted', 'date_format:Y-m-d\TH:i', 'before_or_equal:now'],
+            ])->validate();
+            $duplicate = Contact::where('account_id', $account->id)->where('email', $data['email'])->when($contact, fn ($query) => $query->whereKeyNot($contact->id))->lockForUpdate()->first();
+            if ($duplicate) {
+                throw ValidationException::withMessages(['email' => 'Ya existe un contacto activo con este email en la cuenta.']);
+            }
+            if ($contact && $contact->email !== $data['email']) {
+                throw ValidationException::withMessages(['email' => 'El email identifica al contacto. Crea otro contacto para otra dirección.']);
+            }
+            // A generic CRUD form cannot undo a withdrawal; a dedicated future consent flow must do that.
+            if ($contact?->consent_status === 'revoked' && $data['consent_status'] !== 'revoked') {
+                throw ValidationException::withMessages(['consent_status' => 'No se puede reactivar un consentimiento revocado desde este formulario.']);
+            }
+            if ($data['consent_status'] === 'granted') {
+                $data['consented_at'] = Carbon::createFromFormat('Y-m-d\TH:i', $data['consented_at'], 'UTC')->startOfMinute();
+            } else {
+                $data['consent_source'] = null;
+                $data['consented_at'] = null;
+            }
+            $previous = $contact ? $contact->only(['consent_status', 'consent_source', 'consented_at']) : null;
+            if ($contact) {
+                $contact->fill($data)->save();
+            } else {
+                $contact = Contact::create(['account_id' => $account->id] + $data);
+            }
+            $this->audit($account->id, $id === null ? 'contact.created' : 'contact.updated', ['contact_id' => $contact->id, 'previous_consent' => $previous, 'consent' => $contact->only(['consent_status', 'consent_source', 'consented_at'])]);
+
+            return $contact;
+        });
+    }
+
+    public function deleteContact(int $id): void
+    {
+        DB::transaction(function () use ($id) {
+            $account = $this->writableAccount();
+            $contact = Contact::where('account_id', $account->id)->lockForUpdate()->findOrFail($id);
+            $contact->lists()->detach();
+            $contact->delete();
+            $this->audit($account->id, 'contact.deleted', ['contact_id' => $id]);
+        });
+    }
+
+    public function saveList(?int $id, array $input): ContactList
+    {
+        return DB::transaction(function () use ($id, $input) {
+            $account = $this->writableAccount();
+            $list = $id === null ? null : ContactList::where('account_id', $account->id)->lockForUpdate()->findOrFail($id);
+            $data = Validator::make($input, ['name' => ['required', 'string', 'max:150'], 'description' => ['present', 'string', 'max:500']])->validate();
+            if ($list) {
+                $list->update($data);
+            } else {
+                $list = ContactList::create(['account_id' => $account->id] + $data);
+            }
+            $this->audit($account->id, $id === null ? 'contact_list.created' : 'contact_list.updated', ['list_id' => $list->id]);
+
+            return $list;
+        });
+    }
+
+    public function deleteList(int $id): void
+    {
+        DB::transaction(function () use ($id) {
+            $account = $this->writableAccount();
+            ContactList::where('account_id', $account->id)->findOrFail($id)->delete();
+            $this->audit($account->id, 'contact_list.deleted', ['list_id' => $id]);
+        });
+    }
+
+    public function associate(int $listId, int $contactId, bool $attach): void
+    {
+        DB::transaction(function () use ($listId, $contactId, $attach) {
+            $account = $this->writableAccount();
+            $list = ContactList::where('account_id', $account->id)->lockForUpdate()->findOrFail($listId);
+            $contact = Contact::where('account_id', $account->id)->lockForUpdate()->findOrFail($contactId);
+            if ($attach) {
+                $list->contacts()->syncWithoutDetaching([$contact->id => ['account_id' => $account->id]]);
+            } else {
+                $list->contacts()->detach($contact->id);
+            }
+            $this->audit($account->id, $attach ? 'contact_list.attached' : 'contact_list.detached', ['list_id' => $listId, 'contact_id' => $contactId]);
+        });
+    }
+}
diff --git a/app/Services/MailSettingsService.php b/app/Services/MailSettingsService.php
new file mode 100644
index 0000000..554cf44
--- /dev/null
+++ b/app/Services/MailSettingsService.php
@@ -0,0 +1,126 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\AuditEvent;
+use App\Models\MailMessage;
+use App\Models\MailSender;
+use App\Models\MailSetting;
+use App\Models\Membership;
+use App\Support\MailInput;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+
+class MailSettingsService
+{
+    public function __construct(private AccountContext $context) {}
+
+    public function settings(): MailSetting
+    {
+        $accountId = $this->context->authorize('settings.read')->account_id;
+
+        return MailSetting::where('account_id', $accountId)->first() ?? new MailSetting(['account_id' => $accountId, 'mode' => 'log', 'smtp_port' => 587, 'smtp_security' => 'starttls']);
+    }
+
+    public function senders(): Builder
+    {
+        return MailSender::where('account_id', $this->context->authorize('settings.read')->account_id)->orderByDesc('id');
+    }
+
+    private function writableAccount(): Account
+    {
+        $member = $this->context->authorize('settings.write');
+        $this->context->authorize('settings.read');
+        $account = Account::whereKey($member->account_id)->lockForUpdate()->firstOrFail();
+        $current = Membership::where('account_id', $account->id)->where('user_id', auth()->id())->lockForUpdate()->first();
+        abort_unless($current && Permissions::allows($current, 'settings.write') && Permissions::allows($current, 'settings.read'), 403);
+
+        return $account;
+    }
+
+    public function saveSettings(array $input): void
+    {
+        DB::transaction(function () use ($input) {
+            $account = $this->writableAccount();
+            $data = Validator::make($input, [
+                'mode' => ['bail', 'required', 'string', Rule::in(['log', 'mailpit'])],
+                'smtp_host' => ['bail', 'nullable', 'string', 'max:253', 'regex:/^[A-Za-z0-9.\[\]:-]+$/D'],
+                'smtp_port' => ['bail', 'required', 'integer', 'between:1,65535'],
+                'smtp_security' => ['bail', 'required', 'string', Rule::in(['starttls', 'smtps'])],
+                'smtp_username' => ['bail', 'nullable', 'string', 'max:1024', 'not_regex:/[\r\n]/'],
+                'smtp_password' => ['bail', 'nullable', 'string', 'max:4096', 'not_regex:/[\r\n]/'],
+                'clear_credentials' => ['sometimes', 'boolean'],
+            ])->validate();
+            $settings = MailSetting::where('account_id', $account->id)->lockForUpdate()->first() ?? new MailSetting(['account_id' => $account->id]);
+            $settings->fill(['mode' => $data['mode'], 'smtp_host' => $data['smtp_host'] ?? null, 'smtp_port' => $data['smtp_port'], 'smtp_security' => $data['smtp_security']]);
+            foreach (['smtp_username', 'smtp_password'] as $field) {
+                if ($data['clear_credentials'] ?? false) {
+                    $settings->{$field} = null;
+                } elseif (isset($data[$field]) && $data[$field] !== '') {
+                    $settings->{$field} = $data[$field];
+                }
+            }
+            $settings->save();
+            AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'mail.settings_changed', 'metadata' => ['mode' => $settings->mode, 'external_enabled' => false]]);
+        });
+    }
+
+    public function saveSender(?int $id, array $input): void
+    {
+        DB::transaction(function () use ($id, $input) {
+            $account = $this->writableAccount();
+            $sender = $id === null ? new MailSender(['account_id' => $account->id]) : MailSender::where('account_id', $account->id)->lockForUpdate()->findOrFail($id);
+            Validator::make($input, ['email' => ['bail', 'required', 'string', 'max:254', 'not_regex:/[\r\n]/']])->validate();
+            $input['email'] = mb_strtolower(trim($input['email']));
+            $data = Validator::make($input, ['email' => MailInput::emailRules(), 'name' => ['bail', 'present', 'string', 'max:150', 'not_regex:/[\r\n]/'], 'reply_to' => MailInput::emailRules(false), 'lab_authorized' => ['required', 'boolean']])->validate();
+            if (MailSender::where('account_id', $account->id)->where('email', $data['email'])->when($sender->exists, fn ($query) => $query->whereKeyNot($sender->id))->lockForUpdate()->exists()) {
+                throw ValidationException::withMessages(['email' => 'Este remitente ya existe en la cuenta.']);
+            }
+            $data['reply_to'] = empty($data['reply_to']) ? null : mb_strtolower(trim($data['reply_to']));
+            $sender->fill($data)->save();
+            AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'mail.sender_saved', 'metadata' => ['sender_id' => $sender->id, 'lab_authorized' => $sender->lab_authorized]]);
+        });
+    }
+
+    public function deleteSender(int $id): void
+    {
+        DB::transaction(function () use ($id) {
+            $account = $this->writableAccount();
+            MailSender::where('account_id', $account->id)->lockForUpdate()->findOrFail($id)->delete();
+            AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'mail.sender_deleted', 'metadata' => ['sender_id' => $id]]);
+        });
+    }
+
+    public function test(int $senderId, array $input): MailMessage
+    {
+        $member = $this->context->authorize('settings.read');
+        $this->context->authorize('mail.send');
+
+        return app(AccountMailTransport::class)->send($member->account, $senderId, $input, auth()->id());
+    }
+
+    public function messages(): Builder
+    {
+        return MailMessage::where('account_id', $this->context->authorize('activity.read')->account_id)->orderByDesc('id');
+    }
+
+    public function download(int $id): StreamedResponse
+    {
+        $message = $this->messages()->findOrFail($id);
+        abort_unless($message->artifact_path !== null, 404);
+
+        return response()->streamDownload(function () use ($id) {
+            $message = $this->messages()->findOrFail($id);
+            abort_unless($message->artifact_path !== null, 404);
+            $stream = Storage::disk('mail-artifacts')->readStream($message->artifact_path);
+            fpassthru($stream);
+            fclose($stream);
+        }, 'mensaje-'.$id.'.eml', ['Content-Type' => 'message/rfc822', 'Cache-Control' => 'private, no-store']);
+    }
+}
diff --git a/app/Services/SmtpConnector.php b/app/Services/SmtpConnector.php
new file mode 100644
index 0000000..48796b2
--- /dev/null
+++ b/app/Services/SmtpConnector.php
@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Services;
+
+use App\Support\SmtpUnconfirmed;
+use Psr\Log\NullLogger;
+use Symfony\Component\Mailer\Transport\Smtp\EsmtpTransport;
+use Symfony\Component\Mime\Email;
+use Throwable;
+
+class SmtpConnector
+{
+    // Internal adapter. Callers validate account and decide whether the endpoint is permitted.
+    public function send(array $config, Email $email): void
+    {
+        $transport = null;
+        try {
+            $security = $config['security'];
+            $transport = new EsmtpTransport($config['host'], $config['port'], $security === 'smtps', null, new NullLogger);
+            $transport->setAutoTls($security === 'starttls');
+            $transport->setRequireTls($security !== 'plain');
+            $stream = $transport->getStream();
+            $stream->setTimeout((float) config('emailing.smtp_timeout', 5));
+            $stream->setStreamOptions(['ssl' => ['verify_peer' => true, 'verify_peer_name' => true, 'allow_self_signed' => false]]);
+            if (($config['username'] ?? '') !== '') {
+                $transport->setUsername($config['username']);
+                $transport->setPassword($config['password'] ?? '');
+            }
+            $transport->send($email);
+        } catch (Throwable) {
+            // Raw SMTP errors/debug may contain AUTH, DSNs, paths or message contents.
+            throw new SmtpUnconfirmed;
+        } finally {
+            if ($transport !== null) {
+                try {
+                    $transport->stop();
+                } catch (Throwable) {
+                    // Closing a failed connection must not disclose debug or mask uncertainty.
+                }
+            }
+        }
+    }
+}
diff --git a/app/Services/TemplateService.php b/app/Services/TemplateService.php
new file mode 100644
index 0000000..9a161d7
--- /dev/null
+++ b/app/Services/TemplateService.php
@@ -0,0 +1,137 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\AuditEvent;
+use App\Models\EmailTemplate;
+use App\Models\MailMessage;
+use App\Models\MailSender;
+use App\Models\Membership;
+use App\Support\MailInput;
+use App\Support\TemplatePreview;
+use App\Support\TemplateRenderer;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Validator;
+
+class TemplateService
+{
+    public function __construct(private AccountContext $context, private TemplateRenderer $renderer, private TemplatePreview $preview) {}
+
+    public function templates(string $search = ''): Builder
+    {
+        $accountId = $this->context->authorize('templates.read')->account_id;
+        Validator::make(['search' => $search], ['search' => ['string', 'max:150']])->validate();
+
+        return EmailTemplate::where('account_id', $accountId)->when($search !== '', fn ($query) => $query->where('name', 'like', '%'.$search.'%'))->orderByDesc('id');
+    }
+
+    public function template(int $id): EmailTemplate
+    {
+        return $this->templates()->findOrFail($id);
+    }
+
+    private function writableAccount(): Account
+    {
+        $member = $this->context->authorize('templates.write');
+        $this->context->authorize('templates.read');
+        $account = Account::whereKey($member->account_id)->lockForUpdate()->firstOrFail();
+        $current = Membership::where('account_id', $account->id)->where('user_id', auth()->id())->lockForUpdate()->first();
+        abort_unless($current && Permissions::allows($current, 'templates.read') && Permissions::allows($current, 'templates.write'), 403);
+
+        return $account;
+    }
+
+    private function fields(array $input, bool $saving): array
+    {
+        $rules = [
+            'subject' => ['bail', 'required', 'string', 'max:200', 'not_regex:/[\r\n]/'],
+            'html' => ['bail', 'required', 'string', 'max:100000'],
+            'text' => ['bail', 'present', 'string', 'max:100000'],
+        ];
+        if ($saving) {
+            $rules['name'] = ['bail', 'required', 'string', 'max:150'];
+        }
+        $data = Validator::make($input, $rules)->validate();
+        // Validate every expression now, without executing a template language.
+        foreach (['subject', 'html', 'text'] as $field) {
+            $this->renderer->render($data[$field], array_fill_keys(TemplateRenderer::VARIABLES, 'valor'), $field, $field === 'html');
+        }
+
+        return $data;
+    }
+
+    public function save(?int $id, array $input): EmailTemplate
+    {
+        return DB::transaction(function () use ($id, $input) {
+            $account = $this->writableAccount();
+            $template = $id === null ? new EmailTemplate(['account_id' => $account->id]) : EmailTemplate::where('account_id', $account->id)->lockForUpdate()->findOrFail($id);
+            $template->fill($this->fields($input, true))->save();
+            AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'template.saved', 'metadata' => ['template_id' => $template->id]]);
+
+            return $template;
+        });
+    }
+
+    public function delete(int $id): void
+    {
+        DB::transaction(function () use ($id) {
+            $account = $this->writableAccount();
+            EmailTemplate::where('account_id', $account->id)->lockForUpdate()->findOrFail($id)->delete();
+            AuditEvent::create(['account_id' => $account->id, 'actor_id' => auth()->id(), 'action' => 'template.deleted', 'metadata' => ['template_id' => $id]]);
+        });
+    }
+
+    private function values(Account $account, array $sample): array
+    {
+        $data = Validator::make($sample, ['name' => ['bail', 'nullable', 'string', 'max:150'], 'email' => MailInput::emailRules(false)])->validate();
+
+        return ['contact.name' => $data['name'] ?? '', 'contact.email' => $data['email'] ?? '', 'account.name' => $account->name];
+    }
+
+    private function renderFields(array $fields, array $values): array
+    {
+        $rendered = [];
+        foreach (['subject', 'html', 'text'] as $field) {
+            $rendered[$field] = $this->renderer->render($fields[$field], $values, $field, $field === 'html');
+        }
+        if ($rendered['text'] === '') {
+            $rendered['text'] = html_entity_decode(strip_tags($rendered['html']), ENT_QUOTES | ENT_HTML5, 'UTF-8');
+        }
+
+        return $rendered;
+    }
+
+    public function preview(?int $id, array $input, array $sample): array
+    {
+        $member = $this->context->authorize('templates.read');
+        if ($id !== null) {
+            $this->template($id);
+        }
+        $fields = $this->fields($input, false);
+        $rendered = $this->renderFields($fields, $this->values($member->account, $sample));
+        $rendered['document'] = $this->preview->document($rendered['html']);
+
+        return $rendered;
+    }
+
+    public function senders(): Builder
+    {
+        $member = $this->context->authorize('templates.read');
+        $this->context->authorize('mail.send');
+
+        return MailSender::where('account_id', $member->account_id)->where('lab_authorized', true)->orderByDesc('id');
+    }
+
+    public function test(int $id, int $senderId, string $recipient, array $sample): MailMessage
+    {
+        $member = $this->context->authorize('templates.read');
+        $this->context->authorize('mail.send');
+        $template = $this->template($id);
+        $fields = $this->fields($template->only(['subject', 'html', 'text']), false);
+        $rendered = $this->renderFields($fields, $this->values($member->account, $sample));
+
+        return app(AccountMailTransport::class)->send($member->account, $senderId, ['recipient' => $recipient] + $rendered, auth()->id());
+    }
+}
diff --git a/app/Support/ContactCsv.php b/app/Support/ContactCsv.php
new file mode 100644
index 0000000..0ff2483
--- /dev/null
+++ b/app/Support/ContactCsv.php
@@ -0,0 +1,99 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Validation\ValidationException;
+
+class ContactCsv
+{
+    public const HEADERS = ['email', 'name', 'consent_status', 'consent_source', 'consented_at'];
+
+    private function invalid(string $message): never
+    {
+        throw ValidationException::withMessages(['file' => $message]);
+    }
+
+    public function parse(string $csv, int $maxRows): array
+    {
+        if (! mb_check_encoding($csv, 'UTF-8') || str_contains($csv, "\0")) {
+            $this->invalid('El CSV debe usar UTF-8 y no contener bytes nulos.');
+        }
+        $csv = str_starts_with($csv, "\xEF\xBB\xBF") ? substr($csv, 3) : $csv;
+        $this->checkQuoting($csv);
+        $stream = fopen('php://temp', 'w+');
+        try {
+            fwrite($stream, $csv);
+            rewind($stream);
+            $headers = fgetcsv($stream, null, ',', '"', '');
+            if (! $headers || in_array(null, $headers, true)) {
+                $this->invalid('El archivo necesita encabezados y la columna email.');
+            }
+            $headers = array_map('trim', $headers);
+            if (! in_array('email', $headers, true) || count(array_unique($headers)) !== count($headers) || array_diff($headers, self::HEADERS)) {
+                $this->invalid('Encabezados admitidos, sin repetir: '.implode(', ', self::HEADERS).'. email es obligatorio.');
+            }
+            $rows = [];
+            while (($fields = fgetcsv($stream, null, ',', '"', '')) !== false) {
+                // An empty physical line is not a data record; quoted empty values still are.
+                if ($fields === [null]) {
+                    continue;
+                }
+                if (count($fields) !== count($headers)) {
+                    $this->invalid('El número de columnas no coincide con los encabezados. No se ha importado ninguna fila.');
+                }
+                if (count($rows) >= $maxRows) {
+                    $this->invalid('El CSV supera el límite de '.$maxRows.' registros de datos.');
+                }
+                $rows[] = array_combine($headers, $fields);
+            }
+            if ($rows === []) {
+                $this->invalid('El CSV no contiene registros de datos.');
+            }
+
+            return $rows;
+        } finally {
+            fclose($stream);
+        }
+    }
+
+    private function checkQuoting(string $csv): void
+    {
+        // Validate RFC 4180 lexical structure before PHP's permissive CSV reader.
+        $state = 'start';
+        $length = strlen($csv);
+        for ($i = 0; $i < $length; $i++) {
+            $char = $csv[$i];
+            if ($state === 'quoted') {
+                if ($char === '"') {
+                    if ($i + 1 < $length && $csv[$i + 1] === '"') {
+                        $i++;
+                    } else {
+                        $state = 'after';
+                    }
+                }
+
+                continue;
+            }
+            if ($char === "\r" || $char === "\n") {
+                if ($char === "\r" && ($i + 1 >= $length || $csv[$i + 1] !== "\n")) {
+                    $this->invalid('Usa saltos de línea LF o CRLF en el CSV.');
+                }
+                if ($char === "\r") {
+                    $i++;
+                }
+                $state = 'start';
+            } elseif ($char === ',') {
+                $state = 'start';
+            } elseif ($char === '"' && $state === 'start') {
+                $state = 'quoted';
+            } elseif ($char === '"' || $state === 'after') {
+                $this->invalid('El CSV contiene comillas o separadores mal formados.');
+            } else {
+                $state = 'plain';
+            }
+        }
+        if ($state === 'quoted') {
+            $this->invalid('El CSV contiene un campo entre comillas sin cerrar.');
+        }
+    }
+}
diff --git a/app/Support/HtmlDocument.php b/app/Support/HtmlDocument.php
new file mode 100644
index 0000000..75f0eb1
--- /dev/null
+++ b/app/Support/HtmlDocument.php
@@ -0,0 +1,26 @@
+<?php
+
+namespace App\Support;
+
+use DOMDocument;
+
+class HtmlDocument
+{
+    public static function parse(string $html): DOMDocument
+    {
+        $previous = libxml_use_internal_errors(true);
+        try {
+            $document = new DOMDocument('1.0', 'UTF-8');
+            $document->resolveExternals = false;
+            $document->substituteEntities = false;
+            $document->validateOnParse = false;
+            // No NOENT/DTDLOAD/DTDATTR: external entities and DTDs are never expanded.
+            $document->loadHTML('<?xml encoding="UTF-8">'.$html, LIBXML_NONET | LIBXML_NOERROR | LIBXML_NOWARNING);
+
+            return $document;
+        } finally {
+            libxml_clear_errors();
+            libxml_use_internal_errors($previous);
+        }
+    }
+}
