diff --git a/app/Support/TemplatePreview.php b/app/Support/TemplatePreview.php
new file mode 100644
index 0000000..88e3942
--- /dev/null
+++ b/app/Support/TemplatePreview.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace App\Support;
+
+use DOMDocument;
+use DOMElement;
+use DOMNode;
+use DOMText;
+
+class TemplatePreview
+{
+    public const CSP = "default-src 'none'; script-src 'none'; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; img-src 'none'; style-src 'unsafe-inline'";
+
+    private const TAGS = ['p', 'div', 'span', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'table', 'thead', 'tbody', 'tfoot', 'tr', 'td', 'th', 'caption', 'colgroup', 'col', 'ul', 'ol', 'li', 'strong', 'b', 'em', 'i', 'u', 's', 'small', 'br', 'hr', 'blockquote', 'pre', 'code', 'sub', 'sup'];
+
+    private const DROP = ['script', 'style', 'meta', 'base', 'link', 'iframe', 'frame', 'frameset', 'object', 'embed', 'applet', 'svg', 'math', 'form', 'input', 'button', 'textarea', 'select', 'option', 'video', 'audio', 'source', 'track', 'canvas', 'template', 'noscript', 'title'];
+
+    private const STYLES = ['color', 'background-color', 'font-size', 'font-family', 'font-weight', 'font-style', 'text-align', 'text-decoration', 'border', 'border-collapse', 'border-spacing', 'border-color', 'border-width', 'border-style', 'padding', 'padding-top', 'padding-right', 'padding-bottom', 'padding-left', 'margin', 'margin-top', 'margin-right', 'margin-bottom', 'margin-left', 'width', 'height', 'max-width', 'line-height', 'display', 'vertical-align', 'letter-spacing'];
+
+    public function document(string $html): string
+    {
+        $source = HtmlDocument::parse($html);
+        $safe = new DOMDocument('1.0', 'UTF-8');
+        $body = $safe->createElement('div');
+        $safe->appendChild($body);
+        $sourceBody = $source->getElementsByTagName('body')->item(0);
+        if ($sourceBody) {
+            foreach ($sourceBody->childNodes as $node) {
+                $this->copy($node, $body, $safe);
+            }
+        }
+        $fragment = '';
+        foreach ($body->childNodes as $node) {
+            $fragment .= $safe->saveHTML($node);
+        }
+
+        return '<!doctype html><html><head><meta http-equiv="Content-Security-Policy" content="'.htmlspecialchars(self::CSP, ENT_QUOTES, 'UTF-8').'"><meta charset="utf-8"><meta name="referrer" content="no-referrer"></head><body>'.$fragment.'</body></html>';
+    }
+
+    private function copy(DOMNode $source, DOMNode $parent, DOMDocument $document): void
+    {
+        if ($source instanceof DOMText) {
+            $parent->appendChild($document->createTextNode($source->nodeValue));
+
+            return;
+        }
+        if (! $source instanceof DOMElement) {
+            return;
+        }
+        $tag = strtolower($source->tagName);
+        if (in_array($tag, self::DROP, true)) {
+            return;
+        }
+        if ($tag === 'img') {
+            $image = $document->createElement('span');
+            $image->appendChild($document->createTextNode('[Imagen omitida en preview]'));
+            $parent->appendChild($image);
+
+            return;
+        }
+        // Link destinations/targets are intentionally discarded; email delivery keeps the original HTML.
+        $tag = $tag === 'a' ? 'span' : $tag;
+        $target = $parent;
+        if (in_array($tag, self::TAGS, true)) {
+            $target = $document->createElement($tag);
+            $parent->appendChild($target);
+            $style = $this->style($source->getAttribute('style'));
+            if ($style !== '') {
+                $target->setAttribute('style', $style);
+            }
+            foreach (['width', 'height', 'cellpadding', 'cellspacing', 'border', 'colspan', 'rowspan'] as $attribute) {
+                $value = $source->getAttribute($attribute);
+                if (preg_match('/^\d{1,4}%?$/D', $value)) {
+                    $target->setAttribute($attribute, $value);
+                }
+            }
+        }
+        foreach ($source->childNodes as $child) {
+            $this->copy($child, $target, $document);
+        }
+    }
+
+    private function style(string $style): string
+    {
+        $safe = [];
+        foreach (explode(';', $style) as $declaration) {
+            $parts = explode(':', $declaration, 2);
+            if (count($parts) !== 2) {
+                continue;
+            }
+            $property = strtolower(trim($parts[0]));
+            $value = trim($parts[1]);
+            if (in_array($property, self::STYLES, true) && strlen($value) <= 128 && preg_match('/^[#a-zA-Z0-9\s.,%\-]+$/D', $value)) {
+                $safe[] = $property.':'.$value;
+            }
+        }
+
+        return implode(';', $safe);
+    }
+}
diff --git a/app/Support/TemplateRenderer.php b/app/Support/TemplateRenderer.php
new file mode 100644
index 0000000..dd6d9e0
--- /dev/null
+++ b/app/Support/TemplateRenderer.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Support;
+
+use DOMElement;
+use DOMNode;
+use DOMText;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\ValidationException;
+
+class TemplateRenderer
+{
+    public const VARIABLES = ['contact.name', 'contact.email', 'account.name'];
+
+    public function render(string $source, array $values, string $field, bool $html = false): string
+    {
+        if (! mb_check_encoding($source, 'UTF-8') || strlen($source) > 100000) {
+            $this->invalid($field, 'El contenido debe ser UTF-8 y ocupar como máximo 100.000 bytes.');
+        }
+        foreach (self::VARIABLES as $key) {
+            if (isset($values[$key]) && (! is_string($values[$key]) || ! mb_check_encoding($values[$key], 'UTF-8') || mb_strlen($values[$key]) > 512)) {
+                $this->invalid('values', 'Los valores deben ser textos de hasta 512 caracteres.');
+            }
+        }
+        preg_match_all('/\{\{(.*?)\}\}/s', $source, $matches);
+        if (count($matches[0]) > 200) {
+            $this->invalid($field, 'Máximo 200 variables por campo.');
+        }
+        foreach ($matches[1] as $key) {
+            if (! in_array(trim($key), self::VARIABLES, true)) {
+                $this->invalid($field, 'Variable no admitida. Usa contact.name, contact.email o account.name.');
+            }
+        }
+        $withoutTokens = preg_replace('/\{\{(.*?)\}\}/s', '', $source);
+        if (str_contains($withoutTokens, '{{') || str_contains($withoutTokens, '}}')) {
+            $this->invalid($field, 'Una variable tiene delimitadores sin cerrar o mal formados.');
+        }
+        if ($html && $matches[0] !== []) {
+            $document = HtmlDocument::parse($source);
+            $eligible = 0;
+            $walk = function (DOMNode $node, bool $textContext = true) use (&$walk, &$eligible): void {
+                if ($node instanceof DOMElement && in_array(strtolower($node->tagName), ['script', 'style', 'textarea', 'title', 'head'], true)) {
+                    $textContext = false;
+                }
+                if ($node instanceof DOMText && $textContext) {
+                    $eligible += preg_match_all('/\{\{(.*?)\}\}/s', $node->nodeValue);
+                }
+                foreach ($node->childNodes as $child) {
+                    $walk($child, $textContext);
+                }
+            };
+            $walk($document);
+            if ($eligible !== count($matches[0])) {
+                $this->invalid($field, 'Las variables HTML solo se admiten en texto del cuerpo, no en atributos, CSS, scripts ni comentarios.');
+            }
+        }
+        $rendered = preg_replace_callback('/\{\{(.*?)\}\}/s', function ($match) use ($values, $html) {
+            $value = $values[trim($match[1])] ?? '';
+
+            return $html ? htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') : $value;
+        }, $source);
+        if (strlen($rendered) > 200000) {
+            $this->invalid($field, 'El resultado supera 200.000 bytes.');
+        }
+        if ($field === 'subject') {
+            Validator::make(['subject' => $rendered], ['subject' => ['bail', 'required', 'string', 'max:200', 'not_regex:/[\r\n]/']])->validate();
+        }
+
+        return $rendered;
+    }
+
+    private function invalid(string $field, string $message): never
+    {
+        throw ValidationException::withMessages([$field => $message]);
+    }
+}
