+from pathlib import Path
+import json,re,subprocess,urllib.request,urllib.error,urllib.parse
+out=Path(__file__).resolve().parent;root=out.parents[4];raw=out/'raw/artifacts'
+runs=sorted({p.name[:36] for p in raw.glob('*-docker-cleanup.txt') if re.match(r'^[a-f0-9-]{36}-docker-cleanup.txt$',p.name)})
+assert runs and all(re.fullmatch(r'[a-f0-9-]{36}',r) for r in runs)
+receipt={'runs':len(runs),'mailpit_deleted':0,'native_temporary_deleted':0}
+def request(path,method='GET',body=None):
+ data=json.dumps(body).encode() if body is not None else None
+ req=urllib.request.Request('http://127.0.0.1:18025'+path,data=data,method=method,headers={'Content-Type':'application/json'})
+ with urllib.request.urlopen(req) as response:return json.load(response) if response.headers.get('content-type','').startswith('application/json') else response.read()
+before=request('/api/v1/messages?limit=10000')['messages'];owned=set()
+for run in runs:
+ for message in request('/api/v1/search?query='+urllib.parse.quote(run)+'&limit=1000').get('messages',[]):
+  identifier=message['ID'];detail=request('/api/v1/message/'+identifier)
+  addresses=[entry.get('Address','') for entry in detail.get('To',[])]
+  if not any(run in address and address.endswith('@example.test') for address in addresses):continue
+  owned.add(identifier)
+for identifier in sorted(owned):
+ assert identifier
+ request('/api/v1/messages','DELETE',{'IDs':[identifier]})
+ try:request('/api/v1/message/'+identifier);raise RuntimeError('Own Mailpit message still exists')
+ except urllib.error.HTTPError as error:
+  if error.code!=404:raise
+ receipt['mailpit_deleted']+=1
+after={m['ID'] for m in request('/api/v1/messages?limit=10000')['messages']}
+receipt['other_mailpit_messages_preserved']=all(m['ID'] in after for m in before if m['ID'] not in owned)
+tmp=root/'storage/app/private/livewire-tmp'
+if tmp.exists():
+ for p in tmp.iterdir():
+  if not p.is_file() or not p.resolve().is_relative_to(tmp.resolve()) or p.stat().st_size>6*1024*1024:continue
+  with p.open('rb') as f:sample=f.read(65536)
+  if any(run.encode() in sample for run in runs):p.unlink();receipt['native_temporary_deleted']+=1
+code=r'''
+require '/var/www/emailing/vendor/autoload.php';$app=require '/var/www/emailing/bootstrap/app.php';$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();App\Support\TestingDatabaseGuard::assertSafe();
+$runs=json_decode($argv[1],true);$root=realpath('/var/www/emailing/storage/app/private/livewire-tmp');$deleted=0;
+if($root)foreach(glob($root.'/*') as $path){if(!is_file($path)||!str_starts_with(realpath($path),$root.'/')||filesize($path)>6*1024*1024)continue;$sample=file_get_contents($path,false,null,0,65536);foreach($runs as $run)if(str_contains($sample,$run)){unlink($path);$deleted++;break;}}
+echo json_encode(['temporary_deleted'=>$deleted]);
+'''
+args=['docker','compose','-p','emailing-qa','-f','compose.yaml','-f','tests/.runtime/compose.qa.yaml','exec','-T','emailing-php','php','-r',code,json.dumps(runs)]
+with (raw/'docker-temporary-cleanup.txt').open('wb') as log:p=subprocess.run(args,cwd=root,stdout=log,stderr=subprocess.STDOUT,creationflags=subprocess.CREATE_NO_WINDOW)
+if p.returncode:raise SystemExit('Docker owned temporary cleanup failed')
+receipt['docker_temporary_deleted']=json.loads((raw/'docker-temporary-cleanup.txt').read_text())['temporary_deleted']
+(out/'raw/teardown-extras-attempt-1.json').write_text(json.dumps(receipt,indent=2))
+print(json.dumps(receipt))
