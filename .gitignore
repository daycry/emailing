/vendor/
/node_modules/
/public/build/
/public/hot
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.env.*
!/.env.example
/npm-debug.log
/phpunit.result.cache
/.phpunit.result.cache
/storage/*
!/storage/.gitkeep
/.env
/infra/.env
/infra/.runtime/
/.claude/knowledge-index.sqlite*
/.claude/usage-state.json
/docs/roadmap/*/testing/inspect-ui.mjs
/docs/roadmap/*/testing/**/raw/artifacts/
/tests/.runtime/
/.phpunit.cache/
/docs/evidence/*.json
!/docs/evidence/sendgrid-scenario.json

# Python tooling caches never belong in the public repository.
__pycache__/
*.py[cod]
