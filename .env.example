APP_NAME=Correo
CRONICLE_TRIGGER_SECRET=
CRONICLE_DISPATCH_CLAIM_LIMIT=20
CRONICLE_DISPATCH_BUDGET_MS=10000
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
REGISTRATION_ENABLED=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=emailing
DB_USERNAME=emailing
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=emailing-app
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=emailing
RABBITMQ_QUEUE=emailing.jobs
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_FROM_ADDRESS=equipo@emailing.test
MAIL_FROM_NAME=Correo
LOG_CHANNEL=stack
LOG_LEVEL=info

# Trusted laboratory capture endpoint (separate from authentication mail).
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=11025
MAILPIT_API_URL=http://127.0.0.1:18025

# Durable domain JSON queue; separate from RABBITMQ_QUEUE (ordinary Laravel jobs).
DELIVERY_EXCHANGE=emailing.deliveries
DELIVERY_QUEUE=emailing.deliveries
DELIVERY_ROUTING_KEY=delivery.ready
DELIVERY_BINDING_KEY=delivery.ready
DELIVERY_FAILURE_QUEUE=emailing.deliveries.failed
DELIVERY_PREFETCH=2
DELIVERY_WORKER_LEASE_SECONDS=30
DELIVERY_PAUSE_POLL_SECONDS=30
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BACKOFF_SECONDS=10
DELIVERY_BACKOFF_MAX_SECONDS=3600
# Server-owned shared laboratory pool; never chosen by an account/client.
# Fixed UTC minute/day caps; adjacent windows can admit two minute bursts.
DELIVERY_RELAY_POOL=mailpit-lab
DELIVERY_ACCOUNT_PER_MINUTE=10
DELIVERY_ACCOUNT_PER_DAY=200
DELIVERY_POOL_PER_MINUTE=20
DELIVERY_POOL_PER_DAY=500
