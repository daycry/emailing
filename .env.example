# Copia este archivo a .env. También puedes configurar SMTP desde el panel.
APP_NAME=Emailing
APP_URL=http://127.0.0.1:8080
APP_ENV=local
# Opcional: carpeta absoluta para base de datos, clave y mensajes de prueba.
# APP_STORAGE=C:/emailing-data
# log guarda .eml en storage/outbox; smtp envía a un servidor real.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Mi equipo
MAIL_REPLY_TO=
MAIL_POSTAL_ADDRESS=
